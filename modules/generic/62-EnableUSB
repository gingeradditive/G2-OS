#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

# Auto-mounts USB sticks under /media and exposes them inside the gcode folder,
# so that an operator can print from a stick without touching a terminal.
#
# udev tags the new partition, systemd instantiates usbstick-handler@<kernel>
# from it, and pmount does the mount. Mounting read-only and with --umask 000 is
# deliberate: the printer only ever reads from the stick, and a stick pulled out
# mid-print must not be able to leave a corrupted filesystem behind.

DEPS=(pmount)

ENABLEUSB_MEDIA_FOLDER="/media"
ENABLEUSB_GCODE_FOLDER="/home/${BASE_USER}/printer_data/gcodes"
ENABLEUSB_RULE_FILE="/etc/udev/rules.d/99-usbstick.rules"
ENABLEUSB_SERVICE_FILE="/etc/systemd/system/usbstick-handler@.service"

########################################
# Install dependencies                 #
########################################

apt-get install --yes "${DEPS[@]}"

########################################
# Create the gcode folder              #
########################################

# Moonraker creates this at runtime, but the symlink below needs it to exist now.
sudo -u "${BASE_USER}" mkdir -p "${ENABLEUSB_GCODE_FOLDER}"

########################################
# Expose /media inside the gcodes dir  #
########################################

# -n keeps a re-run from nesting the link inside the previous one. The target is
# an absolute, user-independent path, so it survives the first-boot user rename.
sudo -u "${BASE_USER}" \
    ln -sfn "${ENABLEUSB_MEDIA_FOLDER}" "${ENABLEUSB_GCODE_FOLDER}/media"

########################################
# Install the udev rule                #
########################################

echo "Installing udev rule in ${ENABLEUSB_RULE_FILE}"
cat > "${ENABLEUSB_RULE_FILE}" <<'EOF'
# Hand every added USB stick partition to usbstick-handler@<kernel>.service.
ACTION=="add", KERNEL=="sd[a-z][0-9]", TAG+="systemd", ENV{SYSTEMD_WANTS}="usbstick-handler@%k"
EOF
chmod 644 "${ENABLEUSB_RULE_FILE}"

# No `udevadm control --reload-rules` here: there is no running udev inside the
# build chroot, and the rule is read at boot anyway.

########################################
# Install the mount service            #
########################################

echo "Installing ${ENABLEUSB_SERVICE_FILE}"
cat > "${ENABLEUSB_SERVICE_FILE}" <<'EOF'
[Unit]
Description=Mount USB sticks
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
# The "." mount label puts the stick at /media itself rather than at a
# per-device subdirectory, which is what gives the operator a stable path.
# Carried over unchanged from the previous image; it only holds for one stick
# at a time and has never been exercised on hardware, so verify it there.
ExecStart=/usr/bin/pmount --umask 000 --noatime -r --sync %I .
ExecStop=/usr/bin/pumount /dev/%I
EOF
chmod 644 "${ENABLEUSB_SERVICE_FILE}"

# The unit is template-instantiated by udev on demand, so it is deliberately
# not enabled: there is no target to enable it against.
