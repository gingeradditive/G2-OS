#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

REPO="https://github.com/Arksine/moonraker.git"
DEPS="git"

########################################
# Install dependencies                 #
########################################

apt-get install --yes "${DEPS}"

########################################
# Save current dir and switch to home  #
########################################

pushd "/home/${BASE_USER}" &> /dev/null || exit 1

########################################
# Clone repository                     #
########################################

echo "Cloning Repository"
sudo -u "${BASE_USER}" git clone ${REPO} moonraker

########################################
# Create printer_data directories      #
########################################

create_user_directories

########################################
# Jump into moonraker, run installer   #
# and go back to home                  #
########################################

echo "Execute installer"
pushd "moonraker" &> /dev/null || exit 1

# Workaround for 32-bit ARM (armhf) builds:
if [ "$(dpkg --print-architecture)" = "armhf" ]; then
  echo "armhf detected: pre-installing pillow"
  # Install pillow build dependencies before building from source
  apt-get install --yes libjpeg-dev zlib1g-dev python3-virtualenv
  MOONRAKER_VENV="/home/${BASE_USER}/moonraker-env"
  sudo -u "${BASE_USER}" python3 -m virtualenv "${MOONRAKER_VENV}"
  "${MOONRAKER_VENV}/bin/pip" install "pillow<=12.1.0,>=9.5.0"
  chown -R "${BASE_USER}":"${BASE_USER}" "${MOONRAKER_VENV}"
fi

sudo -u "${BASE_USER}" ./scripts/install-moonraker.sh -s -z
popd &> /dev/null || exit 1

########################################
# Return to saved directory            #
########################################

popd &> /dev/null || exit 1

########################################
# Copy moonraker.conf to config dir    #
########################################

cp /files/moonraker.conf /home/"${BASE_USER}"/printer_data/config/moonraker.conf
chown "${BASE_USER}":"${BASE_USER}" /home/"${BASE_USER}"/printer_data/config/moonraker.conf

########################################
# Copy the allowed services list       #
########################################

# Moonraker will only act on a service that matches moonraker*/klipper* or is
# listed here. Ours match neither: the firmware unit is kalico.service, not
# klipper.service, and g2-service is registered as a managed_service by its own
# update_manager block. Without this file, "restart firmware" from the interface
# and every post-update restart would fail with "Service not allowed".
#
# Moonraker seeds this file from its own defaults only when it does not already
# exist, so depositing it at build time is what makes ours win.
cp /files/moonraker.asvc /home/"${BASE_USER}"/printer_data/moonraker.asvc
chown "${BASE_USER}":"${BASE_USER}" /home/"${BASE_USER}"/printer_data/moonraker.asvc

########################################
# Enable service                       #
########################################

systemctl_if_exists enable moonraker.service
