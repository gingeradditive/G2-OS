#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

REPO="https://github.com/Arksine/moonraker.git"
DEPS="git"

########################################
# Install dependencies                 #
########################################

apt-get install --yes "${DEPS}"

########################################
# Save current dir and switch to home  #
########################################

pushd "/home/${BASE_USER}" &> /dev/null || exit 1

########################################
# Clone repository                     #
########################################

echo "Cloning Repository"
sudo -u "${BASE_USER}" git clone ${REPO} moonraker

########################################
# Create printer_data directories      #
########################################

create_user_directories

########################################
# Jump into moonraker, run installer   #
# and go back to home                  #
########################################

echo "Execute installer"
pushd "moonraker" &> /dev/null || exit 1

# Workaround for 32-bit ARM (armhf) builds:
if [ "$(dpkg --print-architecture)" = "armhf" ]; then
  echo "armhf detected: pre-installing pillow"
  # Install pillow build dependencies before building from source
  apt-get install --yes libjpeg-dev zlib1g-dev python3-virtualenv
  MOONRAKER_VENV="/home/${BASE_USER}/moonraker-env"
  sudo -u "${BASE_USER}" python3 -m virtualenv "${MOONRAKER_VENV}"
  "${MOONRAKER_VENV}/bin/pip" install "pillow<=12.1.0,>=9.5.0"
  chown -R "${BASE_USER}":"${BASE_USER}" "${MOONRAKER_VENV}"
fi

sudo -u "${BASE_USER}" ./scripts/install-moonraker.sh -s -z

########################################
# Allowed services (moonraker.asvc)    #
########################################

# Moonraker writes moonraker.asvc on its first start without fsync: a power
# cut right after it leaves an empty file, which Moonraker never regenerates
# ("Moonraker is not permitted to restart service 'crowsnest'").
# Ship it pre-filled and drop it before start if it is ever empty again.
ASVC_FILE="/home/${BASE_USER}/printer_data/moonraker.asvc"
if [ ! -s "${ASVC_FILE}" ]; then
    sudo -u "${BASE_USER}" cp moonraker/assets/default_allowed_services "${ASVC_FILE}"
fi

# G2-OS: Moonraker only acts on a service that matches moonraker*/klipper* or
# is listed in this file. Ours match neither: the firmware unit is
# kalico.service and g2-service is a managed_service of its own update_manager
# block. Without these entries "restart firmware" from the interface and every
# post-update restart fail with "Service not allowed".
for G2_SERVICE in kalico g2-service; do
    if ! grep -qx "${G2_SERVICE}" "${ASVC_FILE}"; then
        echo "${G2_SERVICE}" | sudo -u "${BASE_USER}" tee -a "${ASVC_FILE}" > /dev/null
    fi
done

# G2-OS: G1OS deletes an empty file and lets Moonraker regenerate its defaults.
# Here the defaults would lose the two entries above, so an empty file is
# restored from a pristine copy kept outside the user's home instead.
ASVC_PRISTINE="/usr/share/${DIST_NAME,,}/moonraker.asvc"
install -D -m 0644 "${ASVC_FILE}" "${ASVC_PRISTINE}"

mkdir -p /etc/systemd/system/moonraker.service.d
cat > /etc/systemd/system/moonraker.service.d/10-asvc.conf <<EOF
[Service]
ExecStartPre=-/bin/sh -c '[ -s ${ASVC_FILE} ] || cp ${ASVC_PRISTINE} ${ASVC_FILE}'
EOF

popd &> /dev/null || exit 1

########################################
# Return to saved directory            #
########################################

popd &> /dev/null || exit 1

########################################
# Copy moonraker.conf to config dir    #
########################################

sudo -u "${BASE_USER}" cp /files/moonraker.conf /home/"${BASE_USER}"/printer_data/config/moonraker.conf

########################################
# Enable service                       #
########################################

systemctl_if_exists enable moonraker.service
